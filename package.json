{
  "name": "@streampack-dev/clientjs",
  "version": "0.2.0",
  "description": "Browser code that streampack's front ends share: comment anchors and Mermaid diagrams",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./anchors": {
      "types": "./src/anchors.d.ts",
      "default": "./src/anchors.js"
    },
    "./mermaid": {
      "types": "./src/mermaid.d.ts",
      "default": "./src/mermaid.js"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude='test/**' test/*.test.js"
  },
  "repository": "github:streampack-dev/clientjs",
  "publishConfig": {
    "registry": "https://nexus.streampack.dev/repository/npm-hosted/"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "pele": "1.6.0"
  }
}
