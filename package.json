{
  "name": "@streampack-dev/clientjs",
  "version": "0.2.2",
  "description": "Browser code that streampack's front ends share: comment anchors and their interface, Mermaid diagrams, the reader's time zone, and the Atlas map",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./anchors": {
      "types": "./src/anchors.d.ts",
      "default": "./src/anchors.js"
    },
    "./mermaid": {
      "types": "./src/mermaid.d.ts",
      "default": "./src/mermaid.js"
    },
    "./annotate": {
      "types": "./src/annotate.d.ts",
      "default": "./src/annotate.js"
    },
    "./zone": {
      "types": "./src/zone.d.ts",
      "default": "./src/zone.js"
    },
    "./atlas": {
      "types": "./src/atlas.d.ts",
      "default": "./src/atlas.js"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude='test/**' test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/streampack-dev/clientjs.git"
  },
  "publishConfig": {
    "registry": "https://nexus.streampack.dev/repository/npm-hosted/"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "pele": "1.6.0"
  }
}
