{
  "about": "Each html is a post's rendered HTML; each text is what streampack's html_text() (lib-blog V78, PostgreSQL 18, en_US.utf8) makes of it. Generated by running that function, not written by hand. Comment anchors are checked against this text, so clientjs must make the same text from the same HTML.",
  "cases": [
    {
      "name": "the post in streampack's CommentAnchorTests",
      "html": "<p>The quick <em>brown</em> fox.</p>\n<p>Tom &amp; Jerry use &lt;b&gt; tags.</p><ul><li>first item</li><li>second item</li></ul>",
      "text": "The quick brown fox. Tom & Jerry use <b> tags. first item second item"
    },
    {
      "name": "paragraphs are apart",
      "html": "<p>one</p><p>two</p>",
      "text": "one two"
    },
    {
      "name": "a line break is a space",
      "html": "<p>x<br>y</p>",
      "text": "x y"
    },
    {
      "name": "inline tags add nothing",
      "html": "<p>bold <strong>x</strong>y and a<span>b</span>c</p>",
      "text": "bold xy and abc"
    },
    {
      "name": "entities are decoded",
      "html": "<p>Tom &amp; Jerry &lt;b&gt; &quot;q&quot; it's&nbsp;here</p>",
      "text": "Tom & Jerry <b> \"q\" it's here"
    },
    {
      "name": "an escaped entity stays escaped",
      "html": "<p>&amp;lt; stays</p>",
      "text": "&lt; stays"
    },
    {
      "name": "a non-breaking space is a space",
      "html": "<p>tab&nbsp;&nbsp;two</p>",
      "text": "tab two"
    },
    {
      "name": "code keeps its words, not its lines",
      "html": "<pre><code>line one\n  line two\n</code></pre>",
      "text": "line one line two"
    },
    {
      "name": "table cells are apart",
      "html": "<table><thead><tr><th>h1</th><th>h2</th></tr></thead><tbody><tr><td>a</td><td>b</td></tr></tbody></table>",
      "text": "h1 h2 a b"
    },
    {
      "name": "a caption is apart from the rows after it",
      "html": "<table><caption>Cap</caption><tbody><tr><td>x</td></tr></tbody></table>",
      "text": "Cap x"
    },
    {
      "name": "whitespace runs close up and the ends are trimmed",
      "html": "<p>  lots   of\n\tspace  </p>",
      "text": "lots of space"
    },
    {
      "name": "quotes, headings and rules are blocks",
      "html": "<blockquote><p>q</p></blockquote><h2 id=\"x\">Head</h2><p>para</p><hr><p>after</p>",
      "text": "q Head para after"
    },
    {
      "name": "lists are apart",
      "html": "<ul><li>one</li><li>two</li></ul><ol><li>three</li></ol><dl><dt>t</dt><dd>d</dd></dl>",
      "text": "one two three t d"
    },
    {
      "name": "details and summary are blocks",
      "html": "<details><summary>Sum</summary><p>body</p></details>",
      "text": "Sum body"
    },
    {
      "name": "an image adds nothing",
      "html": "<p>a<img src=\"x.png\" alt=\"pic\">b</p>",
      "text": "ab"
    },
    {
      "name": "figures and captions are blocks",
      "html": "<figure><img src=\"x.png\" alt=\"\"><figcaption>Fig</figcaption></figure><p>next</p>",
      "text": "Fig next"
    },
    {
      "name": "text outside the ASCII range is as it is",
      "html": "<p>漢字かな — “quotes” é</p>",
      "text": "漢字かな — “quotes” é"
    },
    {
      "name": "a link adds nothing",
      "html": "<p>see <a href=\"https://example.com\" rel=\"nofollow\">this</a>.</p>",
      "text": "see this."
    },
    {
      "name": "divs and sections are blocks",
      "html": "<div>a</div><section>b</section><article>c</article><aside>d</aside><header>e</header><footer>f</footer>",
      "text": "a b c d e f"
    },
    {
      "name": "ideographic and em spaces are whitespace",
      "html": "<p>漢字　　かな and a b</p>",
      "text": "漢字 かな and a b"
    },
    {
      "name": "a narrow no-break space and a zero-width space are not",
      "html": "<p>10 km and a​b</p>",
      "text": "10 km and a​b"
    },
    {
      "name": "inline code adds nothing",
      "html": "<p>call <code>x()</code>, then <kbd>Enter</kbd></p>",
      "text": "call x(), then Enter"
    }
  ]
}
